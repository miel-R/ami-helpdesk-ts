{
  "name": "ami-helpdesk-ts",
  "version": "3.0.0",
  "description": "Ami Helpdesk Chatbot - TypeScript version (same behaviour as ami-helpdesk-node, fully typed)",
  "main": "dist/server/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.dashboard.json",
    "watch": "tsc -p tsconfig.json --watch",
    "start": "node dist/server/server.js",
    "dev": "npm run build && node dist/server/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.dashboard.json --noEmit",
    "build:dashboard": "tsc -p tsconfig.dashboard.json",
    "deploy": "npm run build && docker compose up -d --build",
    "docker:build": "docker build -t ami-helpdesk-ts .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "test": "npm run build && node tools/widget-regress.mjs && node tools/analytics-regress.cjs && node tools/identity-regress.cjs && node tools/identity-signing-regress.cjs && node tools/commands-regress.cjs && node tools/commands-e2e.cjs && node tools/modal-regress.cjs && node tools/smoke-regress.cjs && node tools/durability-regress.cjs",
    "test:widget": "node tools/widget-regress.mjs",
    "test:analytics": "node tools/analytics-regress.cjs",
    "test:identity": "node tools/identity-regress.cjs",
    "test:identity-signing": "node tools/identity-signing-regress.cjs",
    "test:commands": "node tools/commands-regress.cjs",
    "test:e2e": "node tools/commands-e2e.cjs",
    "test:modal": "node tools/modal-regress.cjs",
    "test:smoke": "node tools/smoke-regress.cjs",
    "test:durability": "node tools/durability-regress.cjs",
    "test:pg": "node tools/postgres-paging-regress.cjs"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.24.5",
    "pg": "^8.23.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.7.5",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^9.0.8",
    "nodemon": "^3.0.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
