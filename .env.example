# Ami Helpdesk Node.js - Environment Configuration

# Server
PORT=3000
NODE_ENV=production
CORS_ORIGIN=*

# TLS (serve HTTPS). Leave blank to serve plain HTTP.
# Generate once, e.g.:
#   openssl req -x509 -newkey rsa:2048 -keyout certs/server.key -out certs/server.crt \
#     -days 825 -nodes -subj "/CN=your-server-ip" -addext "subjectAltName=IP:your-server-ip"
TLS_CERT_FILE=
TLS_KEY_FILE=

# AI Providers (at least one required)
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# n8n Webhook (external n8n instance)
# PRODUCTION: used for real ticket submissions. Must be the production
# (/webhook/<id>) path on a workflow that is ACTIVE, otherwise every ticket is
# silently lost.
N8N_WEBHOOK_URL=http://your-n8n-host:5678/webhook/your-workflow-id

# TEST: optional, used only by the `$test-webhook` command. Point it at the
# workflow's Test URL (n8n UI -> Webhook node -> "Test URL"), which is
# /webhook-test/<id> and only answers while the editor is open and you have
# clicked "Execute workflow". This keeps test probes out of the live ticket
# tables. Leave blank to have $test-webhook hit production instead.
# N8N_TEST_WEBHOOK_URL=http://your-n8n-host:5678/webhook-test/your-workflow-id

# Storage paths (defaults are fine)
# ATTACHMENTS_DIR=./data/attachments
# UPLOADS_DIR=./data/uploads

# Database - dedicated Postgres for the chatbot only (optional; leave empty for JSON fallback)
# If set, the chatbot will use Postgres for conversations, users, limits, and cost ledger.
# The Postgres service in docker-compose.yml must be running (docker compose up -d).
# DATABASE_URL=postgres://ami_helpdesk:CHANGE_ME@postgres:5432/ami_helpdesk
# POSTGRES_PASSWORD=CHANGE_ME

# Monitoring dashboard at /admin.html
# Leave blank to allow open access on the LAN. Set a value to require ?key=...
# Use a long random value, e.g.: openssl rand -hex 24
ADMIN_KEY=

# ---------------------------------------------------------------------------
# Chat admin role
# ---------------------------------------------------------------------------
# The MIS helpdesk (PHP) is the identity provider and already knows each person's
# real role, so that is the preferred source. It cannot be read straight from the
# request body though: the widget is client-side, so anyone can post
# `user_role=admin`. Instead MIS SIGNS the role with IDENTITY_SECRET and the
# chatbot verifies the signature (see src/server/identity.js).
#
# 1. Set IDENTITY_SECRET below and give the MIS pages the SAME value.
# 2. Pass AmiChatConfig.identityToken from PHP.
# 3. Delete ADMIN_USERS - it is then unnecessary, because role changes in MIS
#    take effect immediately with no second list to keep in sync.
#
# Generate a secret with:  openssl rand -hex 32
# Blank disables signing and falls back to users.role + ADMIN_USERS.
IDENTITY_SECRET=

# Fallback only, used when IDENTITY_SECRET is blank or the token is absent:
# a comma-separated list of MIS login ids that are always treated as admin, so
# there is a way in before anyone has used the dashboard.
# ADMIN_USERS=remiel.baking

# ---------------------------------------------------------------------------
# Admin data storage
# ---------------------------------------------------------------------------
# Per-user settings, the daily request ledger, and token/cost accounting are
# stored in two JSON files under data/ (users.json, usage.json). That directory
# is the persistent `ami_data` Docker volume, so this data survives container
# restarts and image rebuilds with no database server to run or back up.
# Writes are atomic (temp file + rename) so an interrupted write cannot
# truncate the ledger.

# ---------------------------------------------------------------------------
# Default limits. Individual users can be given their own overrides from the
# admin dashboard (Users & Limits tab); a user with no override inherits these.
# ---------------------------------------------------------------------------
# Chat messages a user may send per day. This is the default that per-user
# overrides inherit, so keep it generous and lower it per person as needed.
REQUESTS_PER_DAY=100
# Support tickets a user may open per day (separate from chat messages)
RATE_LIMIT_PER_DAY=10
# Chat requests allowed per user per minute
RATE_LIMIT_PER_MINUTE=30
# Default upload ceiling per user, in bytes (10 MB)
MAX_FILE_SIZE=10485760
