# Ami Helpdesk Node.js - Environment Configuration
#
# Copy to .env and fill in the blanks:   cp .env.example .env
# docker compose reads .env automatically from this directory.
#
# IMPORTANT: leave a value BLANK rather than typing a placeholder like
# "your-api-key" or "your-server-ip". A placeholder is a non-empty string, so
# the server treats it as a genuinely configured provider or webhook and
# reports itself healthy while silently failing every request. Blank is honest;
# a placeholder is not.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=production
CORS_ORIGIN=*
# Number of reverse proxies sitting in front of this process. Express derives
# req.ip from the socket, so behind a proxy every request looks like it came
# from the proxy itself and rate limiting keys on ONE shared bucket for the
# whole company. Apache is expected in production, hence the default of 1.
# Set 0 if the process is reached directly. Never set true - that trusts every
# hop and lets a client spoof X-Forwarded-For outright.
TRUST_PROXY_HOPS=1
# Timezone for the timestamps written onto tickets. NOT cosmetic: the container
# runs UTC while MIS is in the Philippines, so stamping a ticket with the
# container's own clock files every ticket eight hours behind, and nothing else
# notices.
TIMEZONE=Asia/Manila

# ---------------------------------------------------------------------------
# TLS (serve HTTPS)
# ---------------------------------------------------------------------------
# Leave both blank to serve plain HTTP.
# Generate once, e.g.:
#   openssl req -x509 -newkey rsa:2048 -keyout certs/server.key -out certs/server.crt \
#     -days 825 -nodes -subj "/CN=your-server-ip" -addext "subjectAltName=IP:your-server-ip"
# The certs/ directory must exist on the host - compose mounts it read-only.
TLS_CERT_FILE=
TLS_KEY_FILE=

# ---------------------------------------------------------------------------
# AI Providers (at least one required)
# ---------------------------------------------------------------------------
# Gemini is used whenever its key is present. OpenAI is NOT a runtime fallback:
# it is only consulted when GEMINI_API_KEY is empty.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# n8n Webhook (external n8n instance)
# ---------------------------------------------------------------------------
# PRODUCTION: used for REAL ticket submissions. Must be the production
# (/webhook/<id>) path on a workflow that is ACTIVE, otherwise every ticket is
# silently lost - there is no local queue or retry.
N8N_WEBHOOK_URL=

# TEST: optional, used only by the `$test-webhook` command, so probes never
# insert rows into the live ticket tables. Point it at the workflow's Test URL
# (n8n UI -> Webhook node -> "Test URL"), which is /webhook-test/<id> and only
# answers while the editor is open and you have clicked "Execute workflow".
# Leave blank to have $test-webhook fall back to production instead.
N8N_TEST_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Storage paths (defaults are fine)
# ---------------------------------------------------------------------------
# ATTACHMENTS_DIR=./data/attachments
# UPLOADS_DIR=./data/uploads
#
# For production, point ATTACHMENTS_DIR at the NAS-backed file_master and mount
# the share at the SAME absolute path here and in the n8n container: the app
# sends absolute staged_path values that n8n reads unchanged. Mount the NAS on
# the host FIRST via /etc/fstab - Docker does not manage host mounts.
# See README "Attachment Storage".

# ---------------------------------------------------------------------------
# Database - dedicated Postgres for the chatbot only
# ---------------------------------------------------------------------------
# Set DATABASE_URL and the chatbot uses Postgres for conversations, users,
# limits, and the cost ledger. Leave it blank to run on the JSON fallback, which
# needs no database server at all.
#
# NOTE: POSTGRES_PASSWORD must be set either way. The chatbot container waits for
# the Postgres service to report healthy before it starts, and the Postgres
# image refuses to initialise without a password - so leaving this blank leaves
# the chatbot waiting forever even on the JSON fallback.
#
# The password must match the one inside DATABASE_URL. The two services are
# defined in docker-compose.yml; start them with:  docker compose up -d
# DATABASE_URL=postgres://ami_helpdesk:<password>@postgres:5432/ami_helpdesk
# POSTGRES_PASSWORD=<same password>
PGPOOL_MAX=5
PG_STATEMENT_TIMEOUT_MS=10000
# The daily sweep drops message BODIES older than this. The usage/cost ledger is
# never pruned - it is the accounting record.
MESSAGE_RETENTION_DAYS=180

# ---------------------------------------------------------------------------
# Monitoring dashboard at /Dashboard/
# ---------------------------------------------------------------------------
# Gates the dashboard AND every /api/admin, /api/usage, /api/stats route. Those
# routes return full conversation history, so leaving this blank exposes them to
# anyone on the LAN. "admin" is not a real secret.
# Generate a strong one:  openssl rand -hex 24
ADMIN_KEY=

# ---------------------------------------------------------------------------
# Certificate fallback return URL
# ---------------------------------------------------------------------------
# When a user clicks "Proceed" on the self-signed cert warning, the widget host
# redirects them to /cert-trusted.html with this URL as the ?back= parameter.
# The cert page then uses it for the "Back to the Helpdesk" button.
# Default: https://192.1.5.21/mis_helpdesk/index.php
AMI_CERT_BACK_URL=https://192.1.5.21/mis_helpdesk/index.php

# ---------------------------------------------------------------------------
# Chat admin role
# ---------------------------------------------------------------------------
# The MIS helpdesk (PHP) is the identity provider and already knows each person's
# real role. It cannot be read straight from the request body, because the widget
# is client-side and anyone can post `user_role=admin` - or just curl it. There
# are two trustworthy ways to get the real role in here:
#
#   1. MIS USER DIRECTORY (recommended). The chatbot reads scrf_user.user_role
#      straight from MIS, so MIS is the single source of truth and a role change
#      takes effect within 60 seconds, with NO change to the MIS PHP code at all.
#      This server-to-server read is what makes it trustworthy: nothing in it can
#      be forged. Only SELECTs are ever issued, one table, one column - the same
#      query MIS itself runs:
#        SELECT user_role FROM scrf_user WHERE user_name = ?
#
#   2. SIGNED IDENTITY TOKEN. MIS signs the role with IDENTITY_SECRET and the
#      chatbot verifies the signature (src/server/services/identity.service.ts).
#      Needs AmiChatConfig.identityToken added to the MIS pages, but adds no
#      second database account.
#
# With neither configured, the role falls back to users.role (set from the
# dashboard -> Users & Limits) plus the ADMIN_USERS list below.

# --- 1. MIS user directory (read-only) ---
# Leave MIS_DB_HOST blank to disable it.
# MIS_DB_HOST=
# MIS_DB_PORT=3306
# MIS_DB_NAME=
# MIS_DB_USER=
# MIS_DB_PASSWORD=

# --- 2. Shared secret for the signed identity token ---
# The secret is ONLY ever read by PHP and this container. It must never be
# printed into the page or sent to the browser.
#   PHP  -> AmiChatConfig.identityToken = "<payload>.<hmac>"
#   Node -> verifies the HMAC and uses that role
# Generate one with:  openssl rand -hex 32
# Blank disables signing.
# IDENTITY_SECRET=

# --- Bootstrap fallback ---
# Comma-separated MIS login ids that are always treated as chat admin,
# regardless of the database. The way in before anyone has used the dashboard.
# Promote people properly via the dashboard afterwards and this can be left
# blank - role changes in MIS then take effect immediately, with no second
# list to keep in sync.
# ADMIN_USERS=

# ---------------------------------------------------------------------------
# Default limits
# ---------------------------------------------------------------------------
# Individual users can be given their own overrides from the admin dashboard
# (Users & Limits tab); a user with no override inherits these.
# Chat messages a user may send per day. Deliberately generous; lower it per
# person as needed.
REQUESTS_PER_DAY=100
# Support TICKETS a user may open per day (separate from chat messages).
RATE_LIMIT_PER_DAY=10
# Chat requests allowed per user per minute.
RATE_LIMIT_PER_MINUTE=30
# Default upload ceiling per user, in bytes (10 MB). A per-user dashboard
# override wins.
MAX_FILE_SIZE=10485760
# Conversation turns kept as AI context.
MAX_HISTORY=20

# ---------------------------------------------------------------------------
# Idle handling, in minutes
# ---------------------------------------------------------------------------
# Two separate thresholds: the user is warned first, then the conversation is
# closed. The nudge must be shorter than the timeout.
#
# The warning is a heads-up, not a countdown to a hard cutoff - it says the chat
# is about to close so they can finish their thought. The close ends the session;
# the transcript and its "---------- session ended ----------" marker are kept,
# and the next message starts a fresh conversation.
#
# NOTE: the widget carries a matching built-in 2 minute default
# (public/widget/config.js), so the two agree even when this is unset.
SESSION_NUDGE_MINUTES=2
SESSION_TIMEOUT_MINUTES=5

# ---------------------------------------------------------------------------
# Default token pricing, per ONE MILLION tokens (how providers quote them)
# ---------------------------------------------------------------------------
# These only set the DEFAULTS. Anything saved through the dashboard (Live tab,
# or POST /api/admin/cost-rates) is written to data/cost-rates.json and wins
# until reset - the env vars do not overwrite a saved override.
# COST_INPUT_PER_MILLION=0.30
# COST_OUTPUT_PER_MILLION=2.50

# ---------------------------------------------------------------------------
# Admin data storage
# ---------------------------------------------------------------------------
# Per-user settings, the daily request ledger, and token/cost accounting live in
# JSON files under data/ (users.json, usage.json). That directory is the
# persistent `ami_data` Docker volume, so this data survives container restarts
# and image rebuilds with no database server to run or back up. Writes are atomic
# (temp file + rename), so an interrupted write cannot truncate the ledger.