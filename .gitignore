# Secrets — never commit
.env

# Dependencies
node_modules/

# Build output
dist/

# Runtime data (ledger, conversations, uploads)
data/
uploads/

# Backups & dumps
backups/
*.dump
*.log
server-test*.log

# Local history / sessions
.history/
session-*.md
tmp-edit-*.cjs

# Certs
certs/

# Dashboard CSV/JSON exports. The browser downloads them relative to the served
# page, so they land in public/Dashboard/ when the dashboard is opened from the
# deployed host. They are user data, not build output.
public/Dashboard/ami-*.csv
public/Dashboard/ami-*.json
data/cost-rates.json

# OS / editor
.DS_Store
Thumbs.db
.vscode/
*.swp
